+
+void mp_custom_rect_copy(struct mp_rect* origin , struct mp_rect_custom* copy, bool hflip, bool vflip)
+{
+    copy->x0 = origin->x0;
+    copy->y0 = origin->y0;
+    copy->x1 = origin->x1;
+    copy->y1 = origin->y1;
+
+    if(copy->horizonFlip != hflip)
+    {
+        int temp1 = copy->x0;
+        copy->x0 = copy->x1;
+        copy->x1 = temp1;
+        copy->horizonFlip = hflip;
+    }
+
+    if(copy->verticalFlip != vflip)
+    {
+        int tempy = copy->y0;
+        copy->y0 = copy->y1;
+        copy->y1 = tempy;
+
+        copy->verticalFlip = vflip;
+    }
+
+    origin->x0 = copy->x0;
+    origin->y0 = copy->y0;
+    origin->x1 = copy->x1;
+    origin->y1 = copy->y1;
+}
+
+void mp_custom_rect_resize(struct mp_rect* origin , struct mp_rect_custom* copy)
+{
+    copy->x0 = origin->x0;
+    copy->y0 = origin->y0;
+    copy->x1 = origin->x1;
+    copy->y1 = origin->y1;
+
+    if(copy->horizonFlip)
+    {
+        int temp1 = copy->x0;
+        copy->x0 = copy->x1;
+        copy->x1 = temp1;        
+    }
+
+    if(copy->verticalFlip)
+    {
+        int tempy = copy->y0;
+        copy->y0 = copy->y1;
+        copy->y1 = tempy;        
+    }
+
+    origin->x0 = copy->x0;
+    origin->y0 = copy->y0;
+    origin->x1 = copy->x1;
+    origin->y1 = copy->y1;
+}
