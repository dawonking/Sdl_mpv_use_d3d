+    ADD(dst, "        out_color = vec4(0.0, 0.0, 0.0, 1.0); \n");
+    ADD(dst, "#else\n");
+    ADD(dst, "        gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0); \n");
+    ADD(dst, "#endif\n");
+    ADD(dst, "        return;\n");
+    ADD(dst, "    }\n");
+
+    // ADD(dst, "    if (planeW == 0.0 && planeH == 0.0) {\n");
