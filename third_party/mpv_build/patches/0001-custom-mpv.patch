+static void add_lens_round_value(struct gl_shader_cache *sc, bstr *dst)
+{
+    ADD(dst, "float evaluate_lens_profile(float angle_degrees) {\n");
+    ADD(dst, "    // The round-view coefficients use degrees, from constant to sixth order.\n");
+    ADD(dst, "    float radius = poly1.z;\n");
+    ADD(dst, "    radius = radius * angle_degrees + poly1.y;\n");
+    ADD(dst, "    radius = radius * angle_degrees + poly1.x;\n");
+    ADD(dst, "    radius = radius * angle_degrees + poly0.w;\n");
+    ADD(dst, "    radius = radius * angle_degrees + poly0.z;\n");
+    ADD(dst, "    radius = radius * angle_degrees + poly0.y;\n");
+    ADD(dst, "    return radius * angle_degrees + poly0.x;\n");
+    ADD(dst, "}\n");
+    ADD(dst, "\n");
+    ADD(dst, "vec2 get_distorted_uv(vec2 output_uv, out bool is_valid) {\n");
+    ADD(dst, "    is_valid = true;\n");
+    ADD(dst, "    if (mode < 0.5)\n");
+    ADD(dst, "        return output_uv;\n");
+    ADD(dst, "\n");
+    ADD(dst, "    vec2 radial_offset;\n");
+    ADD(dst, "    if (mode < 1.5) {\n");
+    ADD(dst, "        vec2 screen_offset = output_uv - vec2(0.5);\n");
+    ADD(dst, "        vec3 ray = v1 + v3 * (screen_offset.x * planeW)\n");
+    ADD(dst, "                      + v2 * (screen_offset.y * planeH);\n");
+    ADD(dst, "        float transverse = length(ray.xy);\n");
+    ADD(dst, "        if ((transverse == 0.0 && ray.z == 0.0) || poly1.w == 0.0) {\n");
+    ADD(dst, "            is_valid = false;\n");
+    ADD(dst, "            return vec2(0.0);\n");
+    ADD(dst, "        }\n");
+    ADD(dst, "\n");
+    ADD(dst, "        float angle_degrees = degrees(atan(transverse, ray.z));\n");
+    ADD(dst, "        if (angle_degrees > sgn.z) {\n");
+    ADD(dst, "            is_valid = false;\n");
+    ADD(dst, "            return vec2(0.0);\n");
+    ADD(dst, "        }\n");
+    ADD(dst, "\n");
+    ADD(dst, "        // A ray on the optical axis has no unique azimuth.\n");
+    ADD(dst, "        vec2 direction = transverse > 0.0 ? ray.xy / transverse : vec2(1.0, 0.0);\n");
+    ADD(dst, "        radial_offset = direction * (evaluate_lens_profile(angle_degrees) / poly1.w);\n");
+    ADD(dst, "    } else {\n");
+    ADD(dst, "        vec2 direction;\n");
+    ADD(dst, "        float radius;\n");
+    ADD(dst, "        if (mode < 2.5) {\n");
+    ADD(dst, "            float rotation = radians(output_uv.x * 360.0 + sgn.w);\n");
+    ADD(dst, "            direction = vec2(-sin(rotation), cos(rotation));\n");
+    ADD(dst, "            radius = 1.0 - output_uv.y;\n");
+    ADD(dst, "        } else {\n");
+    ADD(dst, "            float half_index = output_uv.y < 0.5 ? 0.0 : 1.0;\n");
+    ADD(dst, "            float rotation = radians(output_uv.x * 180.0 + sgn.w);\n");
+    ADD(dst, "            direction = vec2(cos(rotation), sin(rotation)) * (1.0 - 2.0 * half_index);\n");
+    ADD(dst, "            // Each half spans the full lens radius, from rim to center.\n");
+    ADD(dst, "            radius = 1.0 - (2.0 * output_uv.y - half_index);\n");
+    ADD(dst, "        }\n");
+    ADD(dst, "        radial_offset = direction * radius;\n");
+    ADD(dst, "    }\n");
+    ADD(dst, "\n");
+    ADD(dst, "    return cal.xy + (cal.zw * sgn.xy) * radial_offset;\n");
+    ADD(dst, "}\n");
+    ADD(dst, "\n");
+}
