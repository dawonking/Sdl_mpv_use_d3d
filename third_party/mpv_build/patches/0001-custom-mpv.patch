+    // ADD(dst, "        return;\n");
+    // ADD(dst, "    }\n");
+
+    if (has_tc0)
+        ADD(dst, "    vec2 texcoord0 = mod_tc0;\n");
+    if (has_tc1)
+        ADD(dst, "    vec2 texcoord1 = mod_tc1;\n");
+    if (has_tc2)
+        ADD(dst, "    vec2 texcoord2 = mod_tc2;\n");
+    if (has_tc3)
