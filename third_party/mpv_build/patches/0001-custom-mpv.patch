+static void add_main_custom(struct gl_shader_cache *sc, bstr *dst)
+{
+    bool has_tc0 = bstr_find(sc->text, bstr0("texcoord0")) >= 0;
+    bool has_tc1 = bstr_find(sc->text, bstr0("texcoord1")) >= 0;
+    bool has_tc2 = bstr_find(sc->text, bstr0("texcoord2")) >= 0;
+    bool has_tc3 = bstr_find(sc->text, bstr0("texcoord3")) >= 0;
+
+    ADD(dst, "    bool valid_uv;\n");
+
+    if (has_tc0)
+        ADD(dst, "    vec2 mod_tc0 = get_distorted_uv(texcoord0, valid_uv);\n");
+    if (has_tc1)
+        ADD(dst, "    vec2 mod_tc1 = get_distorted_uv(texcoord1, valid_uv);\n");
+    if (has_tc2)
+        ADD(dst, "    vec2 mod_tc2 = get_distorted_uv(texcoord2, valid_uv);\n");
