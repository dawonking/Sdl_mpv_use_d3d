--- a/options/m_option.c
+++ b/options/m_option.c
@@ -4009,3 +4009,86 @@
 const m_option_type_t m_option_type_subconfig = {
     .name = "Subconfig",
 };
+
+
+// ADD : Round View
+int parse_round_view(struct mp_log *log, const m_option_t *opt,
+                            struct bstr name, struct bstr param, void *dst)
+{
+    if (param.len == 0)
+        return M_OPT_MISSING_PARAM;
+
+    float f[ROUND_VIEW_NUM_FLOATS];
+    struct bstr rest = param;
+
+    for (int i = 0; i < ROUND_VIEW_NUM_FLOATS; i++) {
+        if (i > 0 && !bstr_eatstart0(&rest, "/"))
+            goto exit;
+        struct bstr next;
+        double d = bstrtod(rest, &next);
+        if (next.start == rest.start)
+            goto exit;
+        f[i] = d;
+        rest = next;
+    }
+    if (rest.len)
+        goto exit;
+
+    if (dst)
+        memcpy(dst, f, sizeof(f));
+    return 1;
+
+exit:
+    mp_err(log, "Option %.*s: invalid round view: '%.*s'\n",
+           BSTR_P(name), BSTR_P(param));
+    mp_info(log, "Format must be %d slash-separated floats.\n",
+            ROUND_VIEW_NUM_FLOATS);
+    return M_OPT_INVALID;
+}
+
+char *print_round_view(const m_option_t *opt, const void *val)
+{
+    float f[ROUND_VIEW_NUM_FLOATS];
+    memcpy(f, val, sizeof(f));
+
+    char *res = talloc_strdup(NULL, "");
+    for (int i = 0; i < ROUND_VIEW_NUM_FLOATS; i++)
+        res = talloc_asprintf_append(res, "%s%.9g", i ? "/" : "", f[i]);
+    return res;
+}
+
+static bool equal_round_view(const m_option_t *opt, void *a, void *b)
+{
+    bool eq = memcmp(a, b, opt->type->size) == 0;
+    // fprintf(stderr, "\n\n !!!! equal: size=%d a=%f b=%f eq=%d\n",
+    //         (int)opt->type->size,
+    //         ((struct RoundViewValue *)a)->mode,
+    //         ((struct RoundViewValue *)b)->mode, (int)eq);
+
+    struct RoundViewValue* recvA = a;
+    struct RoundViewValue* recvB = b;
+    return eq;
+}
+
+static void copy_roundview_opt(const m_option_t* opt , void* dst , const void* src)
+{
+    if (dst && src)
+        memcpy(dst, src, opt->type->size);
+}
+
+//int (*set)(const m_option_t *opt, void *dst, struct mpv_node *src);
+
+// int round_set(const m_option_t* opt , void* dst , struct RoundViewValue)
+// {
+//     return 1;
+// }
+
+
+const m_option_type_t round_view_opt_type = {
+    .name  = "round-view",
+    .size  = sizeof(struct RoundViewValue),
+    .parse = parse_round_view,
+    .print = print_round_view,
+    .copy  = copy_roundview_opt,
+    .equal = equal_round_view,
+};
